{
  "_about": "Per-crew LLM routing. Copy to llm_providers.json (gitignored) to use it. 'profiles' are named provider chains. Each crew names its own profile (LLM_PROFILE in crews/<name>_crew.py, llm_profile in a JSON crew doc); 'crews' is a per-machine OVERRIDE of that; a crew that names none uses 'default'. get_llm() tries each provider in the chosen profile top-to-bottom, and within a provider its models in order, falling through on ANY error (across providers). A provider whose key is missing is skipped. The owner can also choose a model per agent on the node (crews.llm.<agent>) and a TUI pin outranks everything on this machine; see README 'Who picks the profile'. Never add max_tokens. Delete the file to fall back to env (OPENROUTER_MODEL).",
  "_fields": {
    "default": "profile used by a crew that names none",
    "profiles": "name -> { providers:[...] }. A provider: {name, type, api_key_env?, base_url?, context?, models:[...], enabled?}",
    "crews": "agent_name -> profile name. OVERRIDES ONLY: the crew's own LLM_PROFILE is its default",
    "type": "openrouter | ollama (local, keyless) | xai | openai | nvidia (NVIDIA NIM, OpenAI-compatible) | generic (decides the litellm prefix + default base_url)",
    "api_key_env": "NAME of the .env var holding the key (omit for keyless local ollama). Never a key itself",
    "models": "models IN PRIORITY ORDER, each an id string or {id, context}. id has NO litellm prefix. context = that model's MAX context window (tokens) so a chain never over-fills its smallest model",
    "enabled": "optional false to keep a provider in the file but skip it"
  },
  "default": "content-free",
