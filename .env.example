# =====================================================================
# crewaimeat — environment variables. Copy to .env and fill in.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env is gitignored. Keep every secret here, never in the Windows user or
# machine environment: a persisted value silently outranks .env everywhere.
# =====================================================================

# --- OpenRouter (required) -------------------------------------------
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# The single-model default, as "openrouter/<provider>/<model>". Used only when there is no
# llm_providers.json; with that file, each crew's LLM_PROFILE picks its model chain instead.
#   openrouter/deepseek/deepseek-v4-pro      (default; good Finnish prose. grok-4-fast was retired 2026-09)
#   openrouter/openai/gpt-oss-120b           (cheap, fast; a reasoning model)
#   openrouter/openai/gpt-oss-120b:free      (free testing; free ids get retired without notice)
OPENROUTER_MODEL=openrouter/deepseek/deepseek-v4-pro
# Optional: comma-separated OpenRouter model ids tried IN ORDER if the primary errors (a provider 400
# included; OpenRouter allows at most 3), e.g. openai/gpt-oss-120b,z-ai/glm-5.2
OPENROUTER_FALLBACK_MODELS=
# Multi-provider priority chains (recommended): copy llm_providers.example.json to llm_providers.json.
# When present it OVERRIDES OPENROUTER_MODEL above. Point elsewhere with: LLM_PROVIDERS_FILE=path/to.json

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.5

# --- Alternative: xAI directly (leave empty if you use OpenRouter) ---
# Also used by any llm_providers.json provider of type "xai".
#   USE_XAI=1
#   XAI_API_KEY=xai-...
#   XAI_MODEL=xai/<model>
# xAI no longer offers grok-4-fast (checked against https://api.x.ai/v1/models on 2026-09-18); pick a
# current id from that list, e.g. xai/grok-4.3, which the content profile uses.
USE_XAI=
XAI_API_KEY=
XAI_MODEL=

# --- Web search (free, no key) ---------------------------------------
# Chosen automatically: if SEARXNG_URL answers -> SearXNG; otherwise -> DuckDuckGo. A self-hosted
# SearXNG (infra/searxng) is used when it is up, and a bare desktop install falls back by itself.
# Set this if your SearXNG is not at the default http://localhost:21333.
SEARXNG_URL=http://localhost:21333
# Force one backend and skip the detection: searxng | ddg | tavily.
WEB_SEARCH=
# Alternative: Tavily. Enable with USE_TAVILY=1 + a key (https://app.tavily.com/).
USE_TAVILY=
TAVILY_API_KEY=

# --- web-tester: browser automation (optional) -----------------------
# Needs: uv sync + `uv run playwright install chromium`.
# Vision model the screenshot action uses to describe a page (qwen-vl on OpenRouter, ~free).
#   VISION_MODEL=qwen/qwen3-vl-8b-instruct   (cheapest) | qwen/qwen2.5-vl-72b-instruct (strongest)
VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Limit where the browser may navigate (comma-separated host list); empty = allow all.
#   e.g. BROWSER_ALLOWED_DOMAINS=aimeat.io
BROWSER_ALLOWED_DOMAINS=

# --- crew-forge: the agent that builds agents ------------------------
# Your AIMEAT account name (the owner). crew-forge registers the agents it builds under it:
#   aimeat connect --url <node> --owner $AIMEAT_OWNER --agent <name>
# Set this if you run crews/crew_forge_crew.py.
AIMEAT_OWNER=

# --- Lifecycle Central: the coordination floor -----------------------
# This repo is project `crewaimeat` on the floor (see CLAUDE.md, "Lifecycle Central"). A session also
# sets AIMEAT_SESSION=cc-<owner>-<tag> in its own shell — that one is per SESSION, not per repo, so it
# has no value here.
AIMEAT_PROJECT=crewaimeat

# --- Email / SMTP (postman) ------------------------------------------
AIMEAT_SMTP_HOST=
AIMEAT_SMTP_PORT=587
AIMEAT_SMTP_USER=
AIMEAT_SMTP_PASS=
AIMEAT_SMTP_FROM=
# Recipient allowlist (comma-separated). postman REFUSES any recipient not on this list.
AIMEAT_MAIL_TO=
# IMAP (postman inbox — Grok-reply ingestion). Defaults: SMTP host, port 993 SSL.
AIMEAT_IMAP_HOST=
AIMEAT_IMAP_PORT=993
